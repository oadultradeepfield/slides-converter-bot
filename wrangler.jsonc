{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slides-converter-bot",
  "account_id": "b8c62fa1e9e5506c9a181b9d372a9261",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",
  "containers": [
    {
      "class_name": "SlidesConverter",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SLIDES_CONVERTER",
        "class_name": "SlidesConverter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SlidesConverter"]
    }
  ],
  "observability": {
    "enabled": true
  }
}

